@echo off
chcp 65001 >nul
title OpenClaw - WSL2 安裝工具

echo ======================================================================
echo    正在為您安裝與啟用 WSL2 (Windows Subsystem for Linux)
echo ======================================================================
echo.
echo 系統正在為您執行：wsl --install
echo 請保持網路連線，下載過程大約需要 2 ~ 5 分鐘...
echo.

wsl --install

echo.
echo ======================================================================
echo [執行完成]
echo.
echo 如果上方顯示需要重新啟動，請將電腦【重新開機】。
echo 電腦重開機後，再打開 OpenClaw 點擊「Try again」即可！
echo ======================================================================
echo.
pause
